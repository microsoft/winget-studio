<Page
    x:Class="WinGetStudio.Views.ValidationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:model="using:WinGetStudio.Models"
    xmlns:localControls="using:WinGetStudio.Views.Controls"
    xmlns:localConverters="using:WinGetStudio.Converters"
    xmlns:models="using:WinGetStudio.Services.DesiredStateConfiguration.Explorer.Models"
    xmlns:vm="using:WinGetStudio.ViewModels"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SectionMinWidth">100</x:Double>
        <Thickness x:Key="TabViewHeaderMargin">0,6,12,0</Thickness>
    </Page.Resources>

    <!-- Page layout -->
    <Grid x:Name="ContentArea" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel>
            <!-- Description -->
            <TextBlock Margin="0,0,0,8" HorizontalAlignment="Left">
                <Run x:Uid="ValidationPage_Description"/>
                <Hyperlink NavigateUri="https://learn.microsoft.com/en-us/powershell/dsc/concepts/resources/operations?view=dsc-3.0">
                    <Run x:Uid="ValidationPage_LearnMoreLink"/>
                </Hyperlink>
            </TextBlock>

            <!-- Tabs -->
            <TabView AddTabButtonCommand="{x:Bind ViewModel.AddUnitValidationCommand}"
                     TabItemsSource="{x:Bind ViewModel.ValidateUnitList}"
                     TabCloseRequested="UnitValidation_TabCloseRequested"
                     SelectedItem="{x:Bind ViewModel.SelectedUnit, Mode=TwoWay}">
                <TabView.Resources>
                    <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="CardBackgroundFillColorDefaultBrush" />
                </TabView.Resources>
                <TabView.TabItemTemplate>
                    <DataTemplate x:DataType="vm:ValidateUnitViewModel">
                        <TabViewItem>
                            <TabViewItem.Header>
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </TabViewItem.Header>
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xE8E4;"/>
                            </TabViewItem.IconSource>
                        </TabViewItem>
                    </DataTemplate>
                </TabView.TabItemTemplate>
            </TabView>
        </StackPanel>

        <!-- Page command -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Resource AutoSuggestBox -->
            <localControls:ResourceAutoSuggestBox VerticalAlignment="Center" Text="{x:Bind ViewModel.SelectedUnit.Unit.Title, Mode=TwoWay}" />

            <!-- Command bar -->
            <CommandBar Grid.Column="1" HorizontalAlignment="Left" DefaultLabelPosition="Right">
                <AppBarButton x:Uid="ValidationPage_GetButton" Icon="Download" Command="{x:Bind ViewModel.SelectedUnit.GetCommand, Mode=OneWay}" />
                <AppBarButton x:Uid="ValidationPage_SetButton" Icon="Upload" Command="{x:Bind ViewModel.SelectedUnit.SetCommand, Mode=OneWay}" />
                <AppBarButton x:Uid="ValidationPage_TestButton" Icon="Accept" Command="{x:Bind ViewModel.SelectedUnit.TestCommand, Mode=OneWay}" />
                <AppBarButton x:Uid="ValidationPage_CancelButton" Icon="Cancel" Command="{x:Bind ViewModel.SelectedUnit.CancelCommand, Mode=OneWay}" />
                <AppBarButton x:Uid="ValidationPage_UpdateButton" Icon="Sync" Command="{x:Bind ViewModel.SelectedUnit.SaveToSourceCommand, Mode=OneWay}" />
                <AppBarButton x:Uid="ValidationPage_BackButton" Icon="Back" Command="{x:Bind ViewModel.SelectedUnit.BackToSourceCommand, Mode=OneWay}" />
            </CommandBar>
        </Grid>

        <!-- Page content -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="{StaticResource SectionMinWidth}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="{StaticResource SectionMinWidth}"/>
                </Grid.ColumnDefinitions>

                <!-- Settings panel -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Settings header -->
                    <TabView TabWidthMode="SizeToContent" IsAddTabButtonVisible="False" SelectedIndex="0">
                        <TabView.Resources>
                            <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="CardBackgroundFillColorDefaultBrush" />
                            <StaticResource x:Key="TabViewItemHeaderFontSize" ResourceKey="CaptionTextBlockFontSize" />
                            <StaticResource x:Key="TabViewItemHeaderIconSize" ResourceKey="CaptionTextBlockFontSize" />
                        </TabView.Resources>
                        <TabView.TabStripHeader>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="{StaticResource TabViewHeaderMargin}">
                                <FontIcon Glyph="&#xE713;" FontSize="{ThemeResource CaptionTextBlockFontSize}" Margin="{ThemeResource XSmallRightMargin}" />
                                <TextBlock x:Uid="ValidationPage_SettingsTabViewHeader" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"/>
                            </StackPanel>
                        </TabView.TabStripHeader>
                        <TabViewItem Header="YAML" IsClosable="False">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xE943;" />
                            </TabViewItem.IconSource>
                        </TabViewItem>
                    </TabView>

                    <!-- Settings -->
                    <localControls:MonacoEditor Grid.Row="1" Text="{x:Bind ViewModel.SelectedUnit.Unit.SettingsText, Mode=TwoWay}" Syntax="yaml" />
                </Grid>

                <!-- Resizer -->
                <controls:GridSplitter Grid.Column="1" />

                <!-- Results output -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Result header -->
                    <TabView TabWidthMode="SizeToContent"
                             IsAddTabButtonVisible="False"
                             SelectedIndex="{x:Bind ViewModel.SelectedUnit.SelectedTabIndex, Mode=TwoWay}">
                        <TabView.Resources>
                            <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="CardBackgroundFillColorDefaultBrush" />
                            <StaticResource x:Key="TabViewItemHeaderFontSize" ResourceKey="CaptionTextBlockFontSize" />
                            <StaticResource x:Key="TabViewItemHeaderIconSize" ResourceKey="CaptionTextBlockFontSize" />
                        </TabView.Resources>
                        <TabView.TabStripHeader>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="{StaticResource TabViewHeaderMargin}">
                                <FontIcon Glyph="&#xE700;" FontSize="{ThemeResource CaptionTextBlockFontSize}" Margin="{ThemeResource XSmallRightMargin}" />
                                <TextBlock x:Uid="ValidationPage_OutputTabViewHeader" Style="{ThemeResource CaptionTextBlockStyle}"/>
                            </StackPanel>
                        </TabView.TabStripHeader>
                        <TabViewItem x:Name="NoResultTabViewItem"
                                     x:Uid="ValidationPage_NoResultTabViewItem"
                                     IsClosable="False"
                                     Visibility="{x:Bind ViewModel.SelectedUnit.ShowNoResultState, Mode=OneWay}">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xF140;" />
                            </TabViewItem.IconSource>
                        </TabViewItem>
                        <TabViewItem x:Name="YamlResultTabViewItem"
                                     Header="YAML"
                                     IsClosable="False"
                                     Visibility="{x:Bind ViewModel.SelectedUnit.ShowYamlOutput, Mode=OneWay}">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xE943;" />
                            </TabViewItem.IconSource>
                        </TabViewItem>
                        <TabViewItem x:Name="ErrorResultTabViewItem"
                                     x:Uid="ValidationPage_ErrorsTabViewItem"
                                     IsClosable="False"
                                     Visibility="{x:Bind ViewModel.SelectedUnit.ShowErrorOutput, Mode=OneWay}">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xEA39;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </TabViewItem.IconSource>
                        </TabViewItem>
                    </TabView>

                    <!-- Result output box -->
                    <Grid Grid.Row="1">
                        <!-- No results -->
                        <localControls:EmptyStateControl Glyph="&#xE8BC;"
                                                         Visibility="{x:Bind NoResultTabViewItem.IsSelected, Mode=OneWay}"
                                                         x:Uid="ValidationPage_NoResultState" />

                        <!-- Yaml output -->
                        <Grid Visibility="{x:Bind YamlResultTabViewItem.IsSelected, Mode=OneWay}">
                            <localControls:MonacoEditor Text="{x:Bind ViewModel.SelectedUnit.YamlOutput, Mode=OneWay}" Syntax="yaml" IsReadOnly="True" />

                            <!-- Copy button -->
                            <localControls:CopyButton Content="&#xE8C8;"
                                                      Click="{x:Bind CopyYamlResultsToClipboard}"
                                                      VerticalAlignment="Top"
                                                      HorizontalAlignment="Right"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Margin="10"/>
                        </Grid>

                        <!-- Error output -->
                        <Grid Visibility="{x:Bind ErrorResultTabViewItem.IsSelected, Mode=OneWay}"
                              CornerRadius="{ThemeResource CornerRadiusMedium}"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <ScrollViewer Padding="{ThemeResource Padding8Uniform}"
                                          HorizontalScrollMode="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBlock Text="{x:Bind ViewModel.SelectedUnit.ErrorOutput, Mode=OneWay}"
                                           IsTextSelectionEnabled="True"/>
                            </ScrollViewer>

                            <!-- Copy button -->
                            <localControls:CopyButton Content="&#xE8C8;"
                                                      Click="{x:Bind CopyErrorResultsToClipboard}"
                                                      VerticalAlignment="Top"
                                                      HorizontalAlignment="Right"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Margin="10"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>